# Telegram Bot
BOT_TOKEN=

# URL Mini App (HTTPS) — тот же, что в BotFather → Configure Mini App
WEBAPP_URL=https://your-domain.example.com

# Telegram ID админов через запятую (получить у @userinfobot)
ADMIN_TELEGRAM_IDS=

# Supabase (https://supabase.com/dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Yandex Maps: Geocoder + интерактивная карта (https://developer.tech.yandex.ru/)
VITE_YANDEX_MAPS_API_KEY=

# PIN входа в админ-панель Mini App (по умолчанию erd2026)
VITE_ADMIN_PIN=erd2026

# После деплоя на Vercel — тот же URL в WEBAPP_URL и BotFather → Mini App
# WEBAPP_URL=https://your-project.vercel.app
#
# На Vercel добавьте те же переменные (Project → Settings → Environment Variables):
# BOT_TOKEN, ADMIN_TELEGRAM_IDS, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (или VITE_SUPABASE_ANON_KEY)
